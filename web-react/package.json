{
  "name": "abolqasem-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "React web UI for Abolqasem",
  "license": "MIT",
  "keywords": [
    "claude",
    "claude-code",
    "ai",
    "chat",
    "ui",
    "agent",
    "go-backend",
    "react"
  ],
  "scripts": {
    "build": "npm run build:client && npm run build:export-viewer",
    "build:client": "vite build && node scripts/check-startup-budget.mjs",
    "build:export-viewer": "vite build --config vite.export-viewer.config.ts",
    "check": "tsc --noEmit && npm run build:client && npm run build:export-viewer",
    "dev:client": "vite --host 0.0.0.0 --port 5174",
    "test": "bun test"
  },
